#include "Resource.h"
#include <windows.h>

IDI_APP_ICON    ICON    "../assets/Icon.ico"
IDI_SMALL       ICON    "../assets/Icon.ico"
IDR_MAINFRAME   ICON    "../assets/Icon.ico"

// Version resource — update these values for each release
#define VER_MAJOR       1
#define VER_MINOR       0
#define VER_PATCH       0
#define VER_BUILD       0

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "NSTechBytes"
            VALUE "FileDescription",  "MonkeySounds - Keyboard & Mouse Sound Simulator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MonkeySounds"
            VALUE "LegalCopyright",   "\xA9 2024 MonkeySounds. All rights reserved."
            VALUE "OriginalFilename", "MonkeySounds.exe"
            VALUE "ProductName",      "MonkeySounds"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE       "MonkeySounds"
    IDC_MONKEYSOUNDS    "MONKEYSOUNDS"
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "Open MonkeySounds",    IDM_TRAY_SHOW
        MENUITEM SEPARATOR
        MENUITEM "Mute Keyboard Sounds", IDM_TRAY_MUTE_KB
        MENUITEM "Mute Mouse Sounds",    IDM_TRAY_MUTE_MOUSE
        MENUITEM SEPARATOR
        MENUITEM "Exit",                 IDM_TRAY_EXIT
    END
END
